# Required only when creating semantic embeddings with OpenAI.
OPENAI_API_KEY=

# OpenSearch connection and versioned indexes.
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_ITEM_INDEX=it4613-items-v1
OPENSEARCH_CHUNK_INDEX=it4613-chunks-v1

# Embedding contract. Changing these values requires a new semantic index.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_EMBEDDING_BATCH_SIZE=128
